# Server-side only — deliberately NOT prefixed with VITE_, so Vite never
# inlines it into the client bundle. Read by vite.config.ts and handed to the
# dev proxy in server/claude-proxy.ts.
#
# Copy to .env (gitignored) and add your key. Without it the app runs fine —
# the assistant then asks for a key of your own (BYOK), stored in the browser
# and forwarded through this same proxy. A server key here takes over for
# everyone; a BYOK key wins for the browser that set it.
ANTHROPIC_API_KEY=

# --- Dealer admin console -----------------------------------------------------
# Absent = the admin console refuses every request. There is no "open by
# default" mode, because an admin surface that accepts an API key must fail
# closed. Generate one with: openssl rand -hex 32
GABLENOW_ADMIN_TOKEN=

# Admin routes answer loopback only unless this is exactly "true". Set it only
# if you knowingly run `vite --host` and want the console reachable on the LAN.
GABLENOW_ADMIN_ALLOW_REMOTE=false

# --- The gable ERP link -------------------------------------------------------
# The base URL of a running gable backend, WITHOUT a path — the portal appends
# /api/portal/v1/... itself. Example: http://127.0.0.1:8080
#
# UNSET IS A SUPPORTED MODE. With no value here the portal runs standalone
# against its built-in simulator, every screen is labelled "Local simulation",
# and the whole test suite still means something. Set it and the portal becomes
# a real contractor portal: sign-in against gable, gable's catalog at the
# customer's own pricing, and orders that land in gable's `orders` table.
#
# Deliberately NOT prefixed with VITE_, so Vite never inlines it into the client
# bundle. Read by vite.config.ts in dev and by server/serve.ts in production;
# the browser only ever learns THAT an ERP is configured, never where it is.
GABLE_API_URL=

# Strips `Secure` from gable's session cookie as it passes back through the
# proxy.
#
# Needed ONLY when the portal itself is served over plain http — which `npm run
# dev` is. gable sets the cookie `Secure` by default, and a browser silently
# drops a Secure cookie on an http:// origin, so without this a local login
# appears to succeed and every following request is a 401.
#
# Never set it on anything reachable over a network: the session cookie would
# travel in clear text. (gable has the mirror-image switch, INSECURE_COOKIES,
# for the same local-development reason.)
GABLE_ALLOW_INSECURE_COOKIES=true

# --- Production host ----------------------------------------------------------
# server/serve.ts binds 0.0.0.0 by default so a container actually receives
# traffic. Set this to 127.0.0.1 for a local-only run of `npm run serve`.
# HOST=127.0.0.1
# PORT=8080
